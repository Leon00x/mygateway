# 复制为 .dev.vars 并填写真实值（.dev.vars 已被 gitignore，不会提交）
# 本地开发必需；生产环境在 Cloudflare Dash 的 Worker → Settings → Variables and Secrets 配置同名 Secret

# 初始管理员密码（用户名默认为 admin；首次登录后必须修改）
# 生产首次部署会自动生成此 Secret，本地可填写一个至少 10 位的临时密码
INITIAL_ADMIN_PASSWORD=

# Provider Key 加密密钥（base64 编码，解码后恰好 32 字节，openssl rand -base64 32）
MASTER_KEY=

# 旧版本升级兼容：若尚未生成 INITIAL_ADMIN_PASSWORD，可暂时用原 ADMIN_TOKEN
# ADMIN_TOKEN=

# 可选：E2E 真实集成测试用的 DeepSeek Provider Key（缺失时 realtime 测试自动跳过）
# DEEPSEEK_TEST_KEY=sk-xxxx
