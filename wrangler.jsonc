{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 生产 Worker 名称。应与 Cloudflare Dash / Workers Builds 中的项目保持一致。
  "name": "mygateway",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-27",
  "assets": {
    "directory": "./dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/admin/api/*", "/management/v1/*", "/health"]
  },
  // Production D1: 不填 database_id → wrangler deploy 时自动创建并绑定。
  // 首次部署后可用 `wrangler d1 list` 拿到真实 ID，如需固化再回填。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mygateway-db"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  // Workers Logs 免费档：只保留约 10% 请求事件，避免日志额度成为成本来源。
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  // Runtime tuning uses validated source defaults. MASTER_KEY is generated by
  // `npm run secrets:init`; only the initial administrator password is exposed
  // as an optional Deploy Button Secret.
}
