{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 部署时会被替换成你的 Worker 名称（Deploy Button 或本地 wrangler 自动处理）。
  // 手动部署时可用: npx wrangler deploy --name <your-worker-name>
  "name": "mygateway",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-27",
  "assets": {
    "directory": "./dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/admin/api/*", "/health"]
  },
  // Production D1: 不填 database_id → wrangler deploy 时自动创建并绑定。
  // 首次部署后可用 `wrangler d1 list` 拿到真实 ID，如需固化再回填。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mygateway-db"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "vars": {
    "APP_VERSION": "0.1.0",
    "DEFAULT_TIMEZONE": "Asia/Shanghai",
    "MAX_REQUEST_BYTES": "2097152",
    "MAX_CHANNEL_ATTEMPTS": "3",
    "UPSTREAM_HEADER_TIMEOUT_MS": "30000",
    "USAGE_RETENTION_DAYS": "30"
  },
  "env": {
    // Local development: 用占位符让 `wrangler dev` 使用磁盘上的 SQLite。
    "local": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mygateway-db",
          "database_id": "local-dev-placeholder"
        }
      ]
    }
  }
}
